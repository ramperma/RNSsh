/* RNSsh — commercial light theme */

QWidget {
    background-color: #f3f5f8;
    color: #1c2430;
    font-size: 13px;
}

QMainWindow {
    background-color: #f3f5f8;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e6ebf1;
    padding: 2px 10px;
    spacing: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    color: #3d4a5c;
}

QMenuBar::item:selected {
    background-color: #eef3f8;
    color: #0f172a;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d8e0e8;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 6px;
    color: #1e293b;
}

QMenu::item:selected {
    background-color: #0f766e;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #e8edf3;
    margin: 6px 8px;
}

/* —— Header —— */
QFrame#appHeader {
    background-color: #0e1525;
    border: none;
}

QFrame#brandAccent {
    background-color: #0f766e;
    border: none;
    min-height: 3px;
    max-height: 3px;
}

QLabel#brandLogo {
    background: transparent;
    padding: 0;
}

QLabel#brandTitle {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.2px;
    background: transparent;
}

QLabel#brandSubtitle {
    color: #94a3b8;
    font-size: 12px;
    background: transparent;
}

QWidget#contentCanvas {
    background-color: #eef1f5;
}

QFrame#actionBar {
    background: transparent;
    border: none;
}

QFrame#hostsCard {
    background-color: #ffffff;
    border: 1px solid #dce3eb;
    border-radius: 12px;
}

QFrame#hostsCard QStackedWidget,
QWidget#hostsSurface {
    background-color: #ffffff;
    border: none;
}

/* —— Tabs —— */
QTabWidget#mainTabs::pane {
    border: none;
    background: #eef1f5;
    top: -1px;
}

QTabWidget#mainTabs QTabBar::tab {
    background: transparent;
    color: #64748b;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    margin-right: 2px;
    min-width: 96px;
    font-weight: 600;
}

QTabWidget#mainTabs QTabBar::tab:selected {
    background: transparent;
    color: #0f766e;
    border-bottom: 2px solid #0f766e;
}

QTabWidget#mainTabs QTabBar::tab:hover:!selected {
    color: #0f172a;
}

/* —— Settings —— */
QFrame#settingsCard {
    background-color: #ffffff;
    border: 1px solid #dce3eb;
    border-radius: 12px;
}

QLabel#settingsSectionTitle {
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QLabel#settingsHelp,
QLabel#settingsSummary,
QLabel#settingsPaths {
    color: #64748b;
    font-size: 13px;
    background: transparent;
}

QLabel#settingsPaths {
    font-family: "IBM Plex Mono", "Source Code Pro", "Ubuntu Mono", monospace;
    font-size: 12px;
    color: #334155;
}

QPushButton {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #d0d7e2;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #eef3f8;
}

QPushButton:disabled {
    color: #94a3b8;
    background-color: #f8fafc;
    border-color: #e6ebf1;
}

QDialogButtonBox QPushButton#primaryButton,
QPushButton#primaryButton {
    background-color: #0f766e;
    color: #ffffff;
    border: 1px solid #0f766e;
    font-weight: 600;
    padding: 7px 18px;
}

QPushButton#primaryButton:hover {
    background-color: #0d9488;
    border-color: #0d9488;
}

QPushButton#primaryButton:pressed {
    background-color: #115e59;
    border-color: #115e59;
}

QPushButton#primaryButton:disabled {
    background-color: #ccfbf1;
    color: #5eead4;
    border-color: #ccfbf1;
}

/* —— Table / tree —— */
QTreeWidget#hostsTable,
QTableWidget#hostsTable {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: none;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #ccfbf1;
    selection-color: #134e4a;
    outline: 0;
}

QTreeWidget#hostsTable::item,
QTableWidget#hostsTable::item {
    padding: 8px 12px;
    border: none;
}

QTreeWidget#hostsTable::item:selected,
QTableWidget#hostsTable::item:selected {
    background-color: #ccfbf1;
    color: #134e4a;
}

QTreeWidget#hostsTable::branch {
    background: #ffffff;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #e6ebf1;
}

QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid #e6ebf1;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
    min-width: 28px;
}

/* —— Status —— */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e6ebf1;
    color: #64748b;
    padding: 2px 10px;
}

QStatusBar QLabel {
    background: transparent;
    color: #64748b;
    padding: 2px 4px;
    font-size: 12px;
}

QLineEdit#hostSearch {
    min-width: 220px;
    padding: 8px 12px;
    background-color: #ffffff;
}

QLabel#emptyTitle {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QFrame#emptyCard {
    background-color: #ffffff;
    border: 1px solid #e6ebf1;
    border-radius: 14px;
}

QLabel#emptyHint {
    color: #64748b;
    font-size: 14px;
    background: transparent;
    padding: 4px 8px 8px 8px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d7e2;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 22px;
}

QComboBox:focus,
QComboBox:on {
    border: 1px solid #0f766e;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d8e0e8;
    selection-background-color: #ccfbf1;
    selection-color: #134e4a;
    outline: 0;
    padding: 4px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #dce3eb;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #ccfbf1;
    color: #134e4a;
}

/* —— Dialogs —— */
QDialog {
    background-color: #f7f8fa;
}

QDialog QLabel {
    background: transparent;
    color: #334155;
}

QLineEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d0d7e2;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #99f6e4;
    selection-color: #134e4a;
}

QLineEdit:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0f766e;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
    color: #334155;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0f766e;
    border-color: #0f766e;
}

QDialogButtonBox QPushButton {
    min-width: 96px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    background: transparent;
    color: #1e293b;
}

QMessageBox QPushButton {
    min-width: 108px;
    padding: 8px 18px;
}

QToolTip {
    background-color: #0e1525;
    color: #f8fafc;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
}

/* —— Status overlay (voice / AI feedback) —— */
QFrame#overlayCard {
    background-color: rgba(14, 21, 37, 235);
    border: 1px solid #0f766e;
    border-radius: 14px;
}

QLabel#overlayIcon {
    font-size: 24px;
    background: transparent;
}

QLabel#overlayText {
    color: #f8fafc;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}
